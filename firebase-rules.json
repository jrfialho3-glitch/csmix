{
  "rules": {
    "players": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.child('level').isNumber() && newData.child('level').val() >= 1000 && newData.child('level').val() <= 30000"
      }
    },

    "banned": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "mixes": {
      ".read": true,
      "$dateKey": {
        "type": {
          ".write": "auth != null"
        },
        "slots": {
          "$slotNum": {
            ".write": "auth != null",
            ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 24"
          }
        },
        "complete": {
          "$compNum": {
            ".write": "auth != null",
            ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 24"
          }
        }
      }
    },

    "history": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "meta": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "admins": {
      ".read": "auth != null",
      ".write": "root.child('admins').child(auth.uid).val() === true"
    }
  }
}